# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CENTRAL_DIR: diretório raiz da Central de Auditoria (handoffs .md, ondas, decisões, agentes).
# Padrão: ./central (dentro deste repositório — fora do repositório auditado).
# CENTRAL_DIR="C:\\caminho\\para\\central"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Fase 4: plataforma ────────────────────────────────────────────────
# Banco local SQLite (padrão: data/central.db na raiz do projeto).
# Pode ser definido como caminho de arquivo ou ':memory:' (para testes/ambientes efêmeros).
# CENTRAL_DB_PATH="data/central.db"
# CENTRAL_DATA_DIR="data"

# Senha inicial do admin local (login em /api/auth). Trocar após o 1º acesso.
# CENTRAL_ADMIN_PASSWORD="troque-esta-senha"

# Concorrência máxima de execuções de agentes simultâneas (fila interna).
# CENTRAL_MAX_CONCURRENCY=2

# Porta do servidor (padrão 3000).
# PORT=3000

# Provider Devin API (adapter real de execução).
# DEVIN_API_KEY="..."
# DEVIN_API_BASE="https://api.devin.ai/v1"

# Adapter CLI headless genérico (comando + args executado no worktree).
# CENTRAL_CLI_COMMAND="claude"
# CENTRAL_CLI_ARGS="-p"

# GitHub (inspeção de repo + abertura de PR).
# GITHUB_TOKEN="..."

# Notificações externas (webhook Discord/Slack-compatible).
# CENTRAL_NOTIFY_WEBHOOK="https://discord.com/api/webhooks/..."
# CENTRAL_NOTIFY_EVENTS="handoff_dispatched,handoff_status_changed,decision_pending,coordinator_run_done"
